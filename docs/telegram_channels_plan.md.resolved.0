## Шаг 5 — HTTP Handler

Создай: `internal/handler/channel_handler.go`

```go
package handler

import (
    "net/http"
    "github.com/gin-gonic/gin"
    "github.com/google/uuid"
    "github.com/skydy/messenger/internal/service"
)

type ChannelHandler struct {
    svc *service.ChannelService
}

func NewChannelHandler(svc *service.ChannelService) *ChannelHandler {
    return &ChannelHandler{svc: svc}
}

// POST /channels
func (h *ChannelHandler) CreateChannel(c *gin.Context) {
    userID := getUserID(c)
    var req service.CreateChannelRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    ch, err := h.svc.CreateChannel(c.Request.Context(), userID, req)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
        return
    }
    c.JSON(http.StatusCreated, ch)
}

// GET /channels/:channel_id
func (h *ChannelHandler) GetChannel(c *gin.Context) { ... }

// GET /channels (мои каналы / лента)
func (h *ChannelHandler) GetMyChannels(c *gin.Context) { ... }

// GET /channels/search?q=...
func (h *ChannelHandler) SearchChannels(c *gin.Context) { ... }

// PUT /channels/:channel_id
func (h *ChannelHandler) UpdateChannel(c *gin.Context) { ... }

// DELETE /channels/:channel_id
func (h *ChannelHandler) DeleteChannel(c *gin.Context) { ... }

// POST /channels/:channel_id/subscribe
func (h *ChannelHandler) Subscribe(c *gin.Context) { ... }

// DELETE /channels/:channel_id/subscribe
func (h *ChannelHandler) Unsubscribe(c *gin.Context) { ... }

// POST /channels/:channel_id/posts
func (h *ChannelHandler) CreatePost(c *gin.Context) {
    userID := getUserID(c)
    channelID, _ := uuid.Parse(c.Param("channel_id"))
    var req service.CreatePostRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    req.ChannelID = channelID
    post, err := h.svc.PublishPost(c.Request.Context(), userID, req)
    if err != nil {
        c.JSON(http.StatusForbidden, gin.H{"error": err.Error()})
        return
    }
    c.JSON(http.StatusCreated, post)
}

// GET /channels/:channel_id/posts
func (h *ChannelHandler) GetPosts(c *gin.Context) { ... }

// POST /channels/posts/:post_id/view  (засчитать просмотр)
func (h *ChannelHandler) MarkViewed(c *gin.Context) {
    userID := getUserID(c)
    postID, _ := uuid.Parse(c.Param("post_id"))
    _ = h.svc.MarkViewed(c.Request.Context(), postID, userID)
    c.JSON(http.StatusOK, gin.H{"ok": true})
}

// POST /channels/posts/:post_id/reactions
func (h *ChannelHandler) AddReaction(c *gin.Context) { ... }

// DELETE /channels/posts/:post_id/reactions/:reaction
func (h *ChannelHandler) RemoveReaction(c *gin.Context) { ... }

// PUT /channels/:channel_id/members/:user_id/role
func (h *ChannelHandler) UpdateMemberRole(c *gin.Context) { ... }

// POST /channels/posts/:post_id/pin
func (h *ChannelHandler) PinPost(c *gin.Context) { ... }
```

