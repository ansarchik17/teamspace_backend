## Шаг 4 — Service Layer

Создай: `internal/service/channel_service.go`

```go
package service

import (
    "context"
    "errors"
    "github.com/google/uuid"
    "github.com/skydy/messenger/internal/domain"
    "github.com/skydy/messenger/internal/repository"
)

var (
    ErrNotChannelOwner   = errors.New("only channel owner can do this")
    ErrNotChannelAdmin   = errors.New("only channel admins can post")
    ErrNotSubscribed     = errors.New("not subscribed to channel")
    ErrChannelNotFound   = errors.New("channel not found")
    ErrUsernametaken     = errors.New("username already taken")
)

type ChannelService struct {
    repo repository.ChannelRepository
    ws   WebSocketNotifier // для push уведомлений о новых постах
}

func NewChannelService(repo repository.ChannelRepository, ws WebSocketNotifier) *ChannelService {
    return &ChannelService{repo: repo, ws: ws}
}

// CreateChannel — создаёт канал и подписывает создателя как owner
func (s *ChannelService) CreateChannel(ctx context.Context, userID int64, req CreateChannelRequest) (*domain.ChannelView, error) {
    ch := &domain.Channel{
        ID:          uuid.New(),
        Name:        req.Name,
        Description: req.Description,
        Username:    req.Username,
        Type:        req.Type,
        CreatedBy:   userID,
        IsActive:    true,
    }
    if err := s.repo.CreateChannel(ctx, ch); err != nil {
        return nil, err
    }
    // Автоматически добавить создателя как owner
    if err := s.repo.Subscribe(ctx, ch.ID, userID); err != nil {
        return nil, err
    }
    if err := s.repo.UpdateMemberRole(ctx, ch.ID, userID, domain.ChannelRoleOwner); err != nil {
        return nil, err
    }
    return s.repo.GetChannelByID(ctx, ch.ID, userID)
}

// PublishPost — публикует пост (только owner/admin)
func (s *ChannelService) PublishPost(ctx context.Context, userID int64, req CreatePostRequest) (*domain.ChannelPostView, error) {
    member, err := s.repo.GetMember(ctx, req.ChannelID, userID)
    if err != nil || member == nil || member.LeftAt != nil {
        return nil, ErrNotSubscribed
    }
    if member.Role == domain.ChannelRoleSubscriber {
        return nil, ErrNotChannelAdmin
    }

    post := &domain.ChannelPost{
        ID:             uuid.New(),
        ChannelID:      req.ChannelID,
        AuthorID:       userID,
        Content:        req.Content,
        AttachmentURL:  req.AttachmentURL,
        AttachmentType: req.AttachmentType,
        AttachmentSize: req.AttachmentSize,
    }
    if err := s.repo.CreatePost(ctx, post); err != nil {
        return nil, err
    }

    view, err := s.repo.GetPost(ctx, post.ID, userID)
    if err != nil {
        return nil, err
    }

    // Push всем подписчикам через WebSocket
    go s.ws.BroadcastToChannelSubscribers(req.ChannelID, "new_channel_post", view)

    return view, nil
}

// Subscribe — подписаться на канал
func (s *ChannelService) Subscribe(ctx context.Context, channelID uuid.UUID, userID int64) error {
    return s.repo.Subscribe(ctx, channelID, userID)
}

// MarkViewed — засчитать просмотр поста
func (s *ChannelService) MarkViewed(ctx context.Context, postID uuid.UUID, userID int64) error {
    return s.repo.MarkPostViewed(ctx, postID, userID)
}
```

**Request DTO:**
```go
type CreateChannelRequest struct {
    Name        string              `json:"name"        binding:"required,min=1,max=255"`
    Description *string             `json:"description"`
    Username    *string             `json:"username"`
    Type        domain.ChannelType  `json:"type" binding:"required,oneof=public private"`
}

type CreatePostRequest struct {
    ChannelID      uuid.UUID `json:"channel_id"     binding:"required"`
    Content        *string   `json:"content"`
    AttachmentURL  *string   `json:"attachment_url"`
    AttachmentType *string   `json:"attachment_type"`
    AttachmentSize *int64    `json:"attachment_size"`
}
```

