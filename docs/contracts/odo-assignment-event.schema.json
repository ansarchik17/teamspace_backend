{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ODO assignment snapshot event v1 (target contract, not a deployed API)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "revision", "organization_id", "source_system", "identity_issuer", "assignment_id", "document_id", "author_sub", "assignee_sub", "title", "description", "department_id", "priority", "due_date", "timezone", "status", "source_url", "completed_at", "closed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["created", "updated", "status_updated"]},
    "occurred_at": {"$ref": "#/definitions/utcTimestamp"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "organization_id": {"type": "string", "format": "uuid"},
    "source_system": {"const": "documentolog"},
    "identity_issuer": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "assignment_id": {"$ref": "#/definitions/id"},
    "document_id": {"$ref": "#/definitions/id"},
    "author_sub": {"$ref": "#/definitions/subject"},
    "assignee_sub": {"$ref": "#/definitions/subject"},
    "title": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 20000},
    "department_id": {"anyOf": [{"$ref": "#/definitions/id"}, {"type": "null"}]},
    "priority": {"enum": ["low", "medium", "high", "critical"]},
    "due_date": {"anyOf": [{"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, {"type": "null"}]},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Validate membership in IANA TZ database in application code."},
    "status": {"enum": ["assigned", "in_progress", "completed", "closed", "cancelled"]},
    "source_url": {"anyOf": [{"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}, {"type": "null"}], "description": "Application must enforce approved ODO origin, no credentials or tokens."},
    "completed_at": {"anyOf": [{"$ref": "#/definitions/utcTimestamp"}, {"type": "null"}]},
    "closed_at": {"anyOf": [{"$ref": "#/definitions/utcTimestamp"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["assigned", "in_progress", "cancelled"]}}}, "then": {"properties": {"completed_at": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["assigned", "in_progress", "completed", "cancelled"]}}}, "then": {"properties": {"closed_at": {"type": "null"}}}}
  ],
  "definitions": {
    "id": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^\\S+$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!workspace:)\\S+$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
