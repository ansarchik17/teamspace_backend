# Application
# Public web retrieval through the existing workspace-ai service (no LLM call).
AI_WEB_SEARCH_URL=http://alemcloud-api:8000/tools/web-search
ENV=development
APP_NAME=workspace
APP_VERSION=1.0.0
APP_PUBLIC_URL=https://workspace.yourdomain.com
# Public Collabora Online URL; the API also fetches /hosting/discovery from this URL.
COLLABORA_URL=https://office.yourdomain.com
TENANT_BASE_DOMAIN=teamspace.kz

# HTTP Server
# Optional direct speech credentials for the accounted workspace-ai gateway.
# Production deploy imports missing values from the existing AI container.
WORKSPACE_AI_OPENAI_API_KEY=
WORKSPACE_AI_ELEVENLABS_API_KEY=
WORKSPACE_AI_JOB_SIGNING_KEY=
# Leave false until the provider's terminal SSE usage has been verified live.
# The default preserves the SDK/SSE interface using an accounted full response.
WORKSPACE_AI_STREAMING_USAGE_CONFIRMED=false
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=5s

# Database  
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFETIME=5m
POSTGRES_MAX_CONN_IDLE_TIME=1m

# Redis Cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=1440m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=workspace-api
JWT_AUDIENCE=workspace-client

PIN_CRYPTO_KEY=workspace-pin-secret-key
REQUIRE_QR_FOR_WEB_LOGIN_WHEN_MOBILE_REGISTERED=false

# Password Hashing
BCRYPT_COST=12

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_ENABLED=true

# MinIO Object Storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_EGRESS_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=workspace
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/workspace
MINIO_MAX_FILE_SIZE=10485760

# RabbitMQ Event Bus
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_EXCHANGE=events.exchange
RABBITMQ_PRODUCER=workspace-api
RABBITMQ_ENABLED=false

# Logging: console colors levels, HTTP statuses and operation labels; json is for collectors.
LOG_LEVEL=debug
LOG_FORMAT=console
LOG_OUTPUT=stdout

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=3600

# Observability
# Enables the existing protected /metrics endpoint, including AI accounting event counters
# and periodic global database gauges. Gauge aggregation across API instances uses max, not sum.
METRICS_ENABLED=true
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# WebSocket
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_MAX_MESSAGE_SIZE=512
WS_PING_INTERVAL=54s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s

# File Cleanup
FILE_CLEANUP_ENABLED=true
FILE_CLEANUP_INTERVAL=24h
FILE_CLEANUP_BATCH_SIZE=100

# Jitsi
JITSI_APP_ID=my_workspace_app
JITSI_APP_SECRET=
JITSI_DOMAIN=meet.teamspace.kz
WORKSPACE_INTERNAL_TOKEN=

KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_PUBLIC_URL=https://workspace.yourdomain.com/keycloak
KEYCLOAK_REALM=Workspace
KEYCLOAK_REALM_URL=https://workspace.yourdomain.com/keycloak/realms/Workspace
KEYCLOAK_ISSUER=https://workspace.yourdomain.com/keycloak/realms/Workspace
KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/Workspace/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=workspace-client
KEYCLOAK_ALLOWED_CLIENT_IDS=workspace-client,workspace-mobile
KEYCLOAK_TRUSTED_AUDIENCES=workspace-client,account
KEYCLOAK_ALLOWED_AZP=workspace-client,workspace-mobile
EXTERNAL_ADMIN_ENABLED=false
EXTERNAL_ADMIN_CLIENT_ID=workspace-admin
EXTERNAL_ADMIN_ROLES=external_user_admin
KEYCLOAK_CLIENT_ID_MOBILE=workspace-mobile
KEYCLOAK_MOBILE_REDIRECT_URIS=app.workspace://auth/callback
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_ADMIN_CLIENT_REALM=Workspace
KEYCLOAK_ADMIN_CLIENT_ID=workspace-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# IDP OAuth2
IDP_BASE_URL=https://idp.example.com
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_REDIRECT_URI=https://workspace.yourdomain.com/api/v1/auth/idp/callback
IDP_SCOPES=user:basic:read user:email:read
IDP_DEFAULT_LANG=ru
IDP_STATE_TTL_SECONDS=600
IDP_ENV=prod
IDP_REQUEST_TIMEOUT=30s
IDP_ENABLE_DEBUG_API=false

ALEM_API_KEY=API_KEY
ALEM_DEFAULT_MODEL=openai/gpt-oss-120b
# KazLLM for Kazakh notebook answers; empty disables it
ALEM_KAZ_MODEL=astanahub/alemllm
DOCUMENT_PARSE_URL=
DOCUMENT_PARSE_TIMEOUT=30s

SMTP_HOSTS=smtp.yourdomain.com
SMTP_PORT=587
# Enable for implicit TLS submission (usually port 465); otherwise STARTTLS.
SMTP_USE_TLS=true
SMTP_IMPLICIT_TLS=false
# Optional certificate identity when SMTP_HOST is an internal network address.
SMTP_TLS_SERVER_NAME=
SMTP_USERNAME=notifications@yourdomain.com
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=notifications@yourdomain.com

INTERNAL_NOTIFICATION_TOKEN=change-me-internal-notification-token
INTERNAL_MAIL_TOKEN=change-me-internal-mail-token
ODO_HANDOFF_INTERNAL_TOKEN=change-me-odo-handoff-internal-token
# Assignment delivery uses a dedicated Keycloak service account, never handoff tokens.
ODO_ASSIGNMENTS_ENABLED=false
ODO_ASSIGNMENTS_CLIENT_ID=
ODO_ASSIGNMENTS_SERVICE_SUB=
ODO_ASSIGNMENTS_AUDIENCE=
# Explicit company UUID:local automation user ID bindings, comma separated. No wildcard.
ODO_ASSIGNMENTS_COMPANIES=
# Trusted HTTPS origin for document links; leave empty only when source_url is null.
ODO_ASSIGNMENTS_SOURCE_ORIGIN=
# Enable temporarily for the reviewed historical migration only.
ODO_ASSIGNMENTS_BACKFILL_ENABLED=false
# User commands to EDO; no service account may replace the caller.
ODO_COMMANDS_ENABLED=false
ODO_COMMANDS_BASE_URL=
ODO_COMMANDS_TIMEOUT=10s

MAILCOW_API_BASE_URL=https://mail.yourdomain.com
MAILCOW_API_KEY=change-me-mailcow-api-key
MAILCOW_DEFAULT_DOMAIN=yourdomain.com
MAILCOW_DEFAULT_QUOTA_MB=3072
MAILCOW_TLS_ENFORCE_IN=true
MAILCOW_TLS_ENFORCE_OUT=true
MAILCOW_FORCE_PW_UPDATE=false
MAILCOW_INSECURE_SKIP_VERIFY=false
MAILCOW_REQUEST_TIMEOUT=15s
MAILCOW_MAX_SUFFIX_ATTEMPTS=100

# Stalwart mailbox provisioning. Keep admin credentials backend-only.
STALWART_URL=https://mail.teamspace.kz
STALWART_PUBLIC_URL=https://mail.teamspace.kz
STALWART_ADMIN_USER=
STALWART_ADMIN_PASSWORD=
STALWART_DEFAULT_DOMAIN=teamspace.kz
STALWART_DEFAULT_QUOTA_MB=3072
STALWART_REQUEST_TIMEOUT=15s
STALWART_MAX_SUFFIX_ATTEMPTS=100

FIREBASE_CREDENTIALS_FILE=/key/firebase-adminsdk.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple APNS/VoIP credentials. Keep the private key outside Git.
APNS_KEY_PATH=
APNS_KEY_CONTENT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=true

# Employee sync

# LiveKit
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7
LIVEKIT_API_KEY=replace-with-a-random-livekit-key
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret
LIVEKIT_URL=wss://livekit.workspace.yourdomain.com
LIVEKIT_API_URL=http://workspace-livekit:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_PUBLIC_USERS=

# ONLYOFFICE Docs (DOC-001)
# Browser-reachable DocumentServer origin; empty uses the existing /onlyoffice proxy.
ONLYOFFICE_PUBLIC_URL=
# Backend URL reachable FROM DocumentServer; empty uses APP_PUBLIC_URL.
ONLYOFFICE_DOWNLOAD_BASE_URL=
# Must match DocumentServer JWT_SECRET. Empty supports legacy JWT-disabled servers only.
ONLYOFFICE_JWT_SECRET=
# Set a tested, pinned image tag/digest before using docker-compose.onlyoffice.yml.
ONLYOFFICE_IMAGE=

# DOC-007: backend-reachable DocumentServer URL; falls back to absolute ONLYOFFICE_PUBLIC_URL.
ONLYOFFICE_INTERNAL_URL=

# CNT-005: base64-encoded 32-byte AES key for encrypted LDAP bind passwords.
# Keep this key stable and back it up securely; blank disables secret creation/sync.
CONTACTS_DIRECTORY_ENCRYPTION_KEY=
# Exact permitted LDAP URL authorities (host[:port]), comma-separated.
# Both ldaps and ldap+StartTLS always verify certificates; no plaintext bind.
CONTACTS_LDAP_ALLOWED_HOSTS=
# Shared only with the trusted SenimDesk backend; never a browser token.
SD_ACCESS_INTERNAL_TOKEN=
SD_ACCESS_API_URL=

# Meet UI integration with the separate QMeet backend.
# Example public origin: https://92-38-49-156.sslip.io
# Prefer an internal backend origin when both services share a trusted network.
QMEET_API_URL=
QMEET_WORKSPACE_SECRET=
QMEET_WORKSPACE_ISSUER=workspace
QMEET_REQUEST_TIMEOUT=45s

# Personal Team AI: user-scoped read connectors (empty = explicitly unavailable).
# Existing SenimDesk SSO settings SD_ACCESS_API_URL/SD_ACCESS_INTERNAL_TOKEN are reused.
# ODO accepts the current Workspace access JWT; point to its BFF, not gRPC services.
AI_CONTEXT_ODO_URL=
# Corporate mail API with the /api/internal/workspace/ai routes.
AI_CONTEXT_MAIL_URL=
# Optional private origin for CRM/platform APIs; never set this to the LMS container.
GROWY_API_INTERNAL_URL=
# LMS is independent of CRM; empty public URL = APP_PUBLIC_URL + /growy.
GROWY_LMS_PUBLIC_URL=
# Optional private LMS origin, e.g. http://growy-api-1:8000 on the trusted Docker network.
GROWY_LMS_INTERNAL_URL=

# MinIO v2 cluster metrics bearer token, generated with mc admin prometheus generate.
# Capacity metrics are best-effort; logical Drive quotas remain enforced without them.
MINIO_METRICS_TOKEN=
MINIO_CAPACITY_RESERVE_PERCENT=10

# AI credit hold reconciliation (apply the accounting/reconciliation migrations first).
# Unsupported provider usage lookups retain holds for manual review; TTL never waives charges.
AI_RECONCILIATION_ENABLED=false
# Operator CLI only; never read by public HTTP handlers. Supply a separate
# least-privilege connection through the operator environment, not client input.
AI_OPS_DATABASE_URL=
AI_RECONCILIATION_INTERVAL=1m
AI_RECONCILIATION_STALE_AFTER=15m
AI_RECONCILIATION_LEASE=2m
AI_RECONCILIATION_LOOKUP_TIMEOUT=30s
AI_RECONCILIATION_RETRY_DELAY=5m
AI_RECONCILIATION_BATCH_SIZE=25
AI_RECONCILIATION_MAX_CLAIMS=10

# AI Accounting & Enforcement (Task 40)
# AI_ACCOUNTING_ENABLED enables or disables the AI credit reservation, tracking and settlement pipeline.
# If false, paid AI operations and /api/v1/ai/limits return 503 AI_ACCOUNTING_UNAVAILABLE.
# Accepted boolean values: true/false/1/0. Invalid values fail startup.
# Disabling admission NEVER releases unknown holds; settlement/reconciliation continue.
AI_ACCOUNTING_ENABLED=true
# AI_ENFORCEMENT_MODE controls whether financial budget and quota limits block user requests.
# Valid values: "enforced" (default) or "observe".
# "enforced": financial limits (budget exhaustion, unconfigured/zero budget or quota) strictly block
#            requests with 429 AI_QUOTA_EXCEEDED or 403 AI_ACCESS_DISABLED.
# "observe":  financial limits do not reject requests; actual token usage is tracked, settled, and
#            overruns are journaled, allowing unconfigured companies or exceeded quotas to be observed.
#            Security restrictions (account suspension, user blocks, company isolation, concurrency/rate limits)
#            and unpriced models are ALWAYS strictly enforced regardless of the mode.
AI_ENFORCEMENT_MODE=enforced
# Optional operator-only financial exemptions: user_id@organization_uuid pairs.
# Matches that user in that company plus company-funded background calls.
# Colleagues' personal quotas, access checks and accounting remain unchanged.
AI_QUOTA_TEST_SUBJECTS=
# Rollback financial blocking only: keep AI_ACCOUNTING_ENABLED=true and set observe.
# Apply both values consistently to every API instance; public HTTP cannot override them.

# Optional local semantic document retrieval (AI chat + notebook excerpts).
# Install pgvector and run deploy/production/document-search.sql first.
# Blank URL preserves lexical search. Use a self-hosted Ollama endpoint only;
# paid provider APIs remain behind their existing accounting enforcement.
DOCUMENT_EMBEDDING_URL=
DOCUMENT_EMBEDDING_MODEL=workspace-bge-m3-v1
DOCUMENT_EMBEDDING_DIMS=1024
DOCUMENT_EMBEDDING_TIMEOUT=30s

# Shared file retrieval. postgres uses live Drive ACLs and a durable extraction queue.
# elasticsearch explicitly selects the existing adapter; hosted AI billing guards remain.
DRIVE_SEARCH_BACKEND=postgres
# Optional local query rewrite + HyDE. Independent of embedding enablement.
DOCUMENT_QUERY_URL=
DOCUMENT_QUERY_MODEL=
DOCUMENT_QUERY_TIMEOUT=3s
# Optional self-hosted cross-encoder (/rerank); see compose.document-search.yml.
DOCUMENT_RERANK_URL=
DOCUMENT_RERANK_TIMEOUT=5s
