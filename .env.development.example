# npm run dev copies this to .env on first use and generates the two secrets.
ENV=development
APP_NAME=teamspace
APP_PUBLIC_URL=http://localhost:5173
HTTP_PORT=8080
# Optional bind address. host:mac forces 127.0.0.1 behind the HTTPS proxy.
HTTP_HOST=
RUN_DB_MIGRATIONS=true

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_DB=workspace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL_MODE=disable
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

MINIO_ENDPOINT=127.0.0.1:19000
MINIO_EGRESS_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=workspace
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:19000/workspace

JWT_SECRET=GENERATE_ON_FIRST_RUN
PIN_CRYPTO_KEY=GENERATE_ON_FIRST_RUN
REQUIRE_QR_FOR_WEB_LOGIN_WHEN_MOBILE_REGISTERED=false

# Compose imports the Workspace realm and workspace-client automatically.
# Existing local password users (including dev seeds) continue using local JWT.
KEYCLOAK_HTTP_PORT=18082
KEYCLOAK_URL=http://127.0.0.1:18082
KEYCLOAK_PUBLIC_URL=http://localhost:18082
KEYCLOAK_REALM=Workspace
KEYCLOAK_CLIENT_ID=workspace-client
KEYCLOAK_ISSUER=http://localhost:18082/realms/Workspace
KEYCLOAK_JWKS_URL=http://127.0.0.1:18082/realms/Workspace/protocol/openid-connect/certs
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

RABBITMQ_ENABLED=false
MAIL_ENABLED=false
ALEM_API_KEY=
AI_ACCOUNTING_ENABLED=true
AI_ENFORCEMENT_MODE=enforced
AI_RECONCILIATION_ENABLED=false
CALENDAR_CISCO_SCHEDULER_URL=http://127.0.0.1:18003/scheduler/api/create_meeting
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
LOG_FORMAT=console
LOG_OUTPUT=stdout
