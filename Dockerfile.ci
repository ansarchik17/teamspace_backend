# CI supplies the tested digest. The placeholder is deliberately unpublished.
ARG RUNTIME_IMAGE=ghcr.io/west6ide/workspace-backend:ci-base-required
FROM ${RUNTIME_IMAGE}
WORKDIR /app

COPY ci-out/workspace /app/workspace
COPY ci-out/user-merge /app/user-merge
COPY ci-out/migrate /app/migrate
COPY ci-out/ai-accounting /app/ai-accounting
COPY db/migrations /app/db/migrations
COPY docker/entrypoint.sh /app/entrypoint.sh

RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
