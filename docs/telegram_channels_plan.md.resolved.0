## Шаг 3 — Repository Interface + Implementation

Создай: `internal/repository/channel_repository.go`

```go
package repository

import (
    "context"
    "github.com/google/uuid"
    "github.com/skydy/messenger/internal/domain"
)

// Интерфейс (для DI и тестов)
type ChannelRepository interface {
    // Каналы
    CreateChannel(ctx context.Context, ch *domain.Channel) error
    GetChannelByID(ctx context.Context, id uuid.UUID, userID int64) (*domain.ChannelView, error)
    GetChannelByUsername(ctx context.Context, username string, userID int64) (*domain.ChannelView, error)
    UpdateChannel(ctx context.Context, ch *domain.Channel) error
    DeleteChannel(ctx context.Context, id uuid.UUID) error
    GetUserChannels(ctx context.Context, userID int64) ([]domain.ChannelView, error)
    SearchChannels(ctx context.Context, query string, userID int64) ([]domain.ChannelView, error)

    // Подписки
    Subscribe(ctx context.Context, channelID uuid.UUID, userID int64) error
    Unsubscribe(ctx context.Context, channelID uuid.UUID, userID int64) error
    GetMember(ctx context.Context, channelID uuid.UUID, userID int64) (*domain.ChannelMember, error)
    GetAdmins(ctx context.Context, channelID uuid.UUID) ([]domain.ChannelMember, error)
    UpdateMemberRole(ctx context.Context, channelID uuid.UUID, userID int64, role domain.ChannelRole) error
    MuteChannel(ctx context.Context, channelID uuid.UUID, userID int64, mute bool) error

    // Посты
    CreatePost(ctx context.Context, post *domain.ChannelPost) error
    GetPost(ctx context.Context, postID uuid.UUID, userID int64) (*domain.ChannelPostView, error)
    GetPosts(ctx context.Context, channelID uuid.UUID, userID int64, limit, offset int) ([]domain.ChannelPostView, error)
    UpdatePost(ctx context.Context, post *domain.ChannelPost) error
    DeletePost(ctx context.Context, postID uuid.UUID) error
    PinPost(ctx context.Context, postID uuid.UUID, pinned bool) error
    GetPinnedPosts(ctx context.Context, channelID uuid.UUID, userID int64) ([]domain.ChannelPostView, error)

    // Просмотры
    MarkPostViewed(ctx context.Context, postID uuid.UUID, userID int64) error // INSERT ON CONFLICT DO NOTHING + UPDATE views_count

    // Реакции
    AddReaction(ctx context.Context, postID uuid.UUID, userID int64, reaction string) error
    RemoveReaction(ctx context.Context, postID uuid.UUID, userID int64, reaction string) error
    GetReactions(ctx context.Context, postID uuid.UUID, userID int64) ([]domain.ReactionSummary, error)
}

// Ключевые SQL запросы:

// MarkPostViewed — атомарно:
// INSERT INTO channel_post_views(post_id, user_id) VALUES($1,$2) ON CONFLICT DO NOTHING;
// UPDATE channel_posts SET views_count = views_count + 1 WHERE id = $1
//   AND NOT EXISTS (SELECT 1 FROM channel_post_views WHERE post_id=$1 AND user_id=$2);

// GetPosts — с реакциями и флагом is_viewed:
// SELECT cp.*, u.first_name||' '||u.last_name as author_name, u.avatar_url as author_avatar,
//        c.name as channel_name, c.avatar_url as channel_avatar,
//        EXISTS(SELECT 1 FROM channel_post_views WHERE post_id=cp.id AND user_id=$userID) as is_viewed
// FROM channel_posts cp
// JOIN users u ON u.id = cp.author_id
// JOIN channels c ON c.id = cp.channel_id
// WHERE cp.channel_id=$1 AND cp.is_deleted=FALSE
// ORDER BY cp.created_at DESC
// LIMIT $2 OFFSET $3
```

