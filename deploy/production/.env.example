# Public URLs for teamspace.kz.
APP_PUBLIC_URL=https://teamspace.kz
COLLABORA_URL=https://teamspace.kz/office
TENANT_BASE_DOMAIN=teamspace.kz
KEYCLOAK_PUBLIC_URL=https://teamspace.kz/auth
KEYCLOAK_ISSUER=https://teamspace.kz/auth/realms/Workspace
KEYCLOAK_HOSTNAME=https://teamspace.kz/auth

# Stalwart management API; credentials stay only in the server-side .env.
STALWART_URL=https://mail.teamspace.kz
STALWART_PUBLIC_URL=https://mail.teamspace.kz
STALWART_ADMIN_USER=
STALWART_ADMIN_PASSWORD=
STALWART_DEFAULT_DOMAIN=teamspace.kz
STALWART_DEFAULT_QUOTA_MB=3072
STALWART_REQUEST_TIMEOUT=15s
STALWART_MAX_SUFFIX_ATTEMPTS=100

# Application values from the root .env.example must also be present here.
ENV=production
# Optional exact user_id@organization_uuid pairs; no wildcards.
AI_QUOTA_TEST_SUBJECTS=
APP_NAME=workspace
LOG_LEVEL=info
LOG_FORMAT=console
LOG_OUTPUT=stdout
POSTGRES_USER=workspace
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=workspace
REDIS_PASSWORD=replace-with-a-long-random-value
MINIO_ROOT_USER=workspace-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
RABBITMQ_USER=workspace
RABBITMQ_PASSWORD=replace-with-a-long-random-value
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-value
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-value

# Shared only with odo-bff. Use the same 32+ byte random value on both servers.
ODO_HANDOFF_INTERNAL_TOKEN=replace-with-a-long-random-value

# Assignment projection and completion. Enable after the coordinated ODO rollout.
# Service client credentials belong only to ODO; never put its secret here.
ODO_ASSIGNMENTS_ENABLED=false
ODO_ASSIGNMENTS_CLIENT_ID=
ODO_ASSIGNMENTS_SERVICE_SUB=
ODO_ASSIGNMENTS_AUDIENCE=
# <Workspace company UUID>:<active technical user ID>,...
ODO_ASSIGNMENTS_COMPANIES=
ODO_ASSIGNMENTS_SOURCE_ORIGIN=https://teamspace.kz
ODO_ASSIGNMENTS_BACKFILL_ENABLED=false
ODO_COMMANDS_ENABLED=false
# Trusted internal BFF origin, without /api/v1; requires shared Docker network.
ODO_COMMANDS_BASE_URL=http://odo-bff:8080
ODO_COMMANDS_TIMEOUT=10s

# LiveKit. LIVEKIT_URL is the browser/mobile WebSocket endpoint.
# LIVEKIT_API_URL is used only by the backend inside the Docker network.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7
LIVEKIT_API_KEY=replace-with-a-random-livekit-key
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret
LIVEKIT_URL=wss://teamspace.kz/livekit
LIVEKIT_API_URL=http://workspace-livekit:7880
LIVEKIT_PUBLIC_URL=
LIVEKIT_PUBLIC_USERS=

# Optional pinned image override; do not use :latest in production.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e

# Shared only with the trusted SenimDesk backend; never a browser token.
SD_ACCESS_INTERNAL_TOKEN=
SD_ACCESS_API_URL=http://sd-backend:18080

# Internal API origins on workspace_workspace; deployment connects app backends.
AI_CONTEXT_ODO_URL=http://odo-bff:8080
AI_CONTEXT_MAIL_URL=http://axis-mail-app-app-1:4100
AI_WEB_SEARCH_URL=http://alemcloud-api:8000/tools/web-search
IFORM_API_URL=http://iform-backend:8081

# Optional: set only when this origin serves the same Growy modules and tenant data
# as GROWY_PUBLIC_URL. Empty uses the configured public Growy service.
GROWY_API_INTERNAL_URL=

# Meet UI integration with the separate QMeet backend.
# Example public origin: https://92-38-49-156.sslip.io
# Prefer an internal backend origin when both services share a trusted network.
QMEET_API_URL=
QMEET_WORKSPACE_SECRET=
QMEET_WORKSPACE_ISSUER=workspace
QMEET_REQUEST_TIMEOUT=45s

# BAS-018: CIDRs of reverse proxies allowed to supply the client IP. Empty = socket peer only.
SECURITY_AUDIT_TRUSTED_PROXIES=

# Optional token from mc admin prometheus generate for physical capacity checks.
MINIO_METRICS_TOKEN=
MINIO_CAPACITY_RESERVE_PERCENT=10
